generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  READONLY
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum ClassType {
  INDIVIDUAL
  COLECTIVA
  BANDA
  LENGUAJE
  ENSAYO
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  BIZUM
  TARJETA
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PayMethod {
  MONTHLY_SALARY
  HOURLY
  PER_CLASS
}

enum PayoutStatus {
  PENDING
  PARTIAL
  PAID
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  passwordHash   String
  role           UserRole @default(ADMIN)
  /// Se incrementa al cambiar la contraseña para invalidar las sesiones abiertas.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SchoolSettings {
  id           String        @id @default("default")
  name         String        @default("Escuela de Música")
  address      String?
  phone        String?
  email        String?
  logoBase64   String?
  logoPath     String?
  activeYearId String?       @unique
  activeYear   AcademicYear? @relation("ActiveYear", fields: [activeYearId], references: [id])
  updatedAt    DateTime      @updatedAt
}

model AcademicYear {
  id        String          @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean         @default(false)
  createdAt DateTime        @default(now())
  activeFor SchoolSettings? @relation("ActiveYear")
}

model IncomeCategory {
  id           String        @id @default(cuid())
  name         String        @unique
  sortOrder    Int           @default(0)
  /// La app registra estos movimientos por su cuenta (cobros de cuotas o pagos a
  /// profesores): no se admiten apuntes manuales nuevos y los antiguos no cuentan
  /// en el balance, para no duplicarlos.
  managedByApp Boolean       @default(false)
  entries      IncomeEntry[]
}

model ExpenseCategory {
  id           String         @id @default(cuid())
  name         String         @unique
  sortOrder    Int            @default(0)
  /// La app registra estos movimientos por su cuenta (cobros de cuotas o pagos a
  /// profesores): no se admiten apuntes manuales nuevos y los antiguos no cuentan
  /// en el balance, para no duplicarlos.
  managedByApp Boolean        @default(false)
  entries      ExpenseEntry[]
}

model Teacher {
  id                  String          @id @default(cuid())
  firstName           String
  lastName            String
  phone               String?
  email               String?
  specialty           String?
  /// Un único método de cálculo de honorarios; `payRate` es su tarifa en céntimos
  /// (€/mes, €/hora o €/clase según el método).
  payMethod           PayMethod       @default(HOURLY)
  payRate             Int             @default(0)
  /// Se suma por cada día con al menos una clase en el horario.
  transportCostPerDay Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?
  classGroups         ClassGroup[]
  primaryStudents     Student[]       @relation("PrimaryTeacher")
  payouts             TeacherPayout[]
}

model Student {
  id               String            @id @default(cuid())
  firstName        String
  lastName         String
  birthDate        DateTime?
  phone            String?
  email            String?
  address          String?
  legalGuardian    String?
  notes            String?
  mainInstrument   String?
  level            String?
  primaryTeacherId String?
  primaryTeacher   Teacher?          @relation("PrimaryTeacher", fields: [primaryTeacherId], references: [id])
  monthlyFee       Int?
  status           StudentStatus     @default(ACTIVE)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  enrollments      Enrollment[]
  discounts        StudentDiscount[]
  fees             StudentFee[]

  @@index([deletedAt, status])
}

model ClassGroup {
  id              String              @id @default(cuid())
  name            String
  type            ClassType
  teacherId       String
  teacher         Teacher             @relation(fields: [teacherId], references: [id])
  room            String?
  durationMinutes Int                 @default(60)
  maxStudents     Int                 @default(1)
  notes           String?
  /// Primer día en que se imparte (fecha de calendario). Las liquidaciones cuentan
  /// sus sesiones desde ese día; vacío = sin restricción (clases ya existentes).
  startDate       DateTime?
  /// Borrado lógico: la clase deja de existir para el futuro, pero sigue
  /// contando en las liquidaciones de los días en que se impartió.
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  enrollments     Enrollment[]
  sessions        AttendanceSession[]
  scheduleSlots   ClassScheduleSlot[]

  @@index([teacherId])
}

/// Horario recurrente semanal (1 = lunes … 7 = domingo). Horas en HH:mm.
model ClassScheduleSlot {
  id            String                      @id @default(cuid())
  classGroupId  String
  classGroup    ClassGroup                  @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  dayOfWeek     Int
  startTime     String
  endTime       String
  cancellations ClassScheduleCancellation[]

  @@unique([classGroupId, dayOfWeek, startTime])
}

/// Sesión concreta suspendida (festivo, libranza) sin borrar la franja semanal.
model ClassScheduleCancellation {
  id             String            @id @default(cuid())
  scheduleSlotId String
  scheduleSlot   ClassScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: Cascade)
  sessionDate    String
  reason         String?
  createdAt      DateTime          @default(now())

  @@unique([scheduleSlotId, sessionDate])
  @@index([sessionDate])
}

model Enrollment {
  id           String     @id @default(cuid())
  studentId    String
  classGroupId String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  enrolledAt   DateTime   @default(now())
  active       Boolean    @default(true)

  @@unique([studentId, classGroupId])
  @@index([classGroupId])
}

model TariffRule {
  id         String     @id @default(cuid())
  name       String
  instrument String?
  level      String?
  classType  ClassType?
  amount     Int
  priority   Int        @default(0)
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model StudentDiscount {
  id            String       @id @default(cuid())
  studentId     String
  student       Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name          String
  type          DiscountType
  value         Int
  isScholarship Boolean      @default(false)
  validFrom     DateTime?
  validTo       DateTime?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@index([studentId])
}

model StudentFee {
  id             String           @id @default(cuid())
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  yearMonth      String
  baseAmount     Int
  discountAmount Int              @default(0)
  totalAmount    Int
  amountPaid     Int              @default(0)
  status         FeeStatus        @default(PENDING)
  dueDate        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  payments       StudentPayment[]
  lineItems      String?

  @@unique([studentId, yearMonth])
  @@index([yearMonth, status])
  @@index([status])
}

model StudentPayment {
  id        String        @id @default(cuid())
  feeId     String
  fee       StudentFee    @relation(fields: [feeId], references: [id], onDelete: Cascade)
  amount    Int
  method    PaymentMethod
  paidAt    DateTime      @default(now())
  notes     String?
  createdAt DateTime      @default(now())

  @@index([feeId])
  @@index([paidAt])
}

model TeacherPayout {
  id              String                 @id @default(cuid())
  teacherId       String
  teacher         Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  yearMonth       String
  baseAmount      Int                    @default(0)
  transportAmount Int                    @default(0)
  workDays        Int                    @default(0)
  amount          Int
  amountPaid      Int                    @default(0)
  status          PayoutStatus           @default(PENDING)
  notes           String?
  /// Fecha del último pago (se mantiene a partir de `payments`).
  paidAt          DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  payments        TeacherPayoutPayment[]

  @@unique([teacherId, yearMonth])
  @@index([yearMonth, status])
}

/// Cada pago realizado a cuenta de una liquidación. `TeacherPayout.amountPaid` es su suma.
model TeacherPayoutPayment {
  id        String        @id @default(cuid())
  payoutId  String
  payout    TeacherPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  amount    Int
  paidAt    DateTime      @default(now())
  notes     String?
  createdAt DateTime      @default(now())

  @@index([payoutId])
}

model IncomeEntry {
  id         String         @id @default(cuid())
  date       DateTime
  concept    String
  categoryId String
  category   IncomeCategory @relation(fields: [categoryId], references: [id])
  amount     Int
  method     PaymentMethod?
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([date])
}

model ExpenseEntry {
  id         String          @id @default(cuid())
  date       DateTime
  concept    String
  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount     Int
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([date])
}

model AttendanceSession {
  id           String             @id @default(cuid())
  classGroupId String
  classGroup   ClassGroup         @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  sessionDate  DateTime
  notes        String?
  createdAt    DateTime           @default(now())
  records      AttendanceRecord[]

  @@unique([classGroupId, sessionDate])
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  present   Boolean           @default(true)
  notes     String?

  @@unique([sessionId, studentId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  username   String
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
